<UserControl x:Class="MdViewer.App.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" Padding="0,10,0,6">
                            <StackPanel>
                                <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="13" />
                                <Border x:Name="Underline" Height="3" Margin="16,6,16,0" CornerRadius="1.5" Background="Transparent" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Pestañas -->
        <UniformGrid DockPanel.Dock="Top" Rows="1">
            <RadioButton x:Name="FilesTab" Style="{StaticResource TabButton}" Content="Archivos" GroupName="SidebarTabs" Checked="OnTabChecked" />
            <RadioButton x:Name="OutlineTab" Style="{StaticResource TabButton}" Content="Índice" GroupName="SidebarTabs" Checked="OnTabChecked" />
            <RadioButton x:Name="SearchTab" Style="{StaticResource TabButton}" Content="Buscar" GroupName="SidebarTabs" Checked="OnTabChecked" />
        </UniformGrid>

        <Grid>
            <!-- ── Archivos ── -->
            <DockPanel x:Name="FilesPanel" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="10,4,4,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ViewToggleButton" Style="{StaticResource IconButton}" Content="☷" ToolTip="Cambiar entre árbol y lista de documentos" Click="OnViewToggleClick" />
                        <Button Style="{StaticResource IconButton}" Content="⟳" ToolTip="Actualizar" Click="OnRefreshClick" />
                        <Button Style="{StaticResource IconButton}" Content="📂" ToolTip="Abrir carpeta…" Click="OnOpenFolderClick" />
                    </StackPanel>
                    <TextBlock x:Name="FolderName" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SidebarForegroundBrush}" />
                </DockPanel>

                <Grid>
                    <TreeView x:Name="FileTree" BorderThickness="0" Background="Transparent" Padding="4,0"
                              MouseDoubleClick="OnFileTreeActivate" KeyDown="OnFileTreeKeyDown" SelectedItemChanged="OnFileTreeSelected" />
                    <ListBox x:Name="ArticleList" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnArticleSelected" KeyDown="OnArticleKeyDown" />
                    <StackPanel x:Name="NoFolderPanel" VerticalAlignment="Center" Margin="16" Visibility="Collapsed">
                        <TextBlock Text="No hay ninguna carpeta abierta." TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource SidebarForegroundBrush}" Opacity="0.7" />
                        <Button Content="Abrir carpeta…" Margin="0,12,0,0" HorizontalAlignment="Center" Padding="12,4" Click="OnOpenFolderClick" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- ── Índice ── -->
            <DockPanel x:Name="OutlinePanel" Visibility="Collapsed">
                <TextBox x:Name="OutlineFilter" DockPanel.Dock="Top" Margin="10,4,10,6" ToolTip="Filtrar títulos" TextChanged="OnOutlineFilterChanged" />
                <Grid>
                    <ListBox x:Name="OutlineList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnOutlineClick" KeyDown="OnOutlineKeyDown" />
                    <TextBlock x:Name="NoHeadingsText" Text="El documento no tiene títulos." Margin="16" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Foreground="{DynamicResource SidebarForegroundBrush}" Opacity="0.7" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <!-- ── Buscar en la carpeta ── -->
            <DockPanel x:Name="SearchPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="10,4,10,6">
                    <TextBox x:Name="SearchBox" KeyDown="OnSearchBoxKeyDown" ToolTip="Buscar en todos los documentos de la carpeta (Intro)" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="SearchCase" Style="{StaticResource OptionToggle}" Content="Aa" ToolTip="Distinguir mayúsculas" />
                        <ToggleButton x:Name="SearchWord" Style="{StaticResource OptionToggle}" Content="Palabra" ToolTip="Solo palabras completas" />
                        <ToggleButton x:Name="SearchRegex" Style="{StaticResource OptionToggle}" Content=".*" ToolTip="Expresión regular" />
                        <Button Content="Buscar" Padding="10,1" Click="OnSearchClick" />
                    </StackPanel>
                    <TextBlock x:Name="SearchSummary" Margin="0,6,0,0" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               Foreground="{DynamicResource SidebarForegroundBrush}" />
                </StackPanel>
                <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnSearchResultActivate" KeyDown="OnSearchResultKeyDown" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
