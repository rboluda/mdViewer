<Window x:Class="MdViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:MdViewer.App.Controls"
        Title="mdViewer" Width="1180" Height="780" MinWidth="520" MinHeight="340" FontSize="12"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/mdViewer.ico"
        Background="{DynamicResource DocumentBackgroundBrush}"
        AllowDrop="True">

    <DockPanel>
        <!-- El contenido de los menús se construye en MainWindow.Menus.cs -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource MenuBarBackgroundBrush}" Padding="2,1" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1" />

        <StatusBar x:Name="StatusBarPanel" DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackgroundBrush}"
                   TextElement.Foreground="{DynamicResource ChromeForegroundBrush}" Padding="2,0" Height="22">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SidebarToggleButton" Content="☰" ToolTip="Mostrar u ocultar la barra lateral (Ctrl+Mayús+L)"
                            Padding="4,0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource ChromeForegroundBrush}" Click="OnSidebarToggleClick" />
                    <Button x:Name="ModeToggleButton" Content="&lt;/&gt;" ToolTip="Modo código fuente (Ctrl+/)"
                            Padding="4,0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource ChromeForegroundBrush}" Click="OnModeToggleClick" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource ChromeForegroundBrush}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ReadonlyText" Text="Solo lectura" Margin="0,0,12,0" Visibility="Collapsed"
                               VerticalAlignment="Center" Foreground="{DynamicResource ChromeForegroundBrush}" />
                    <Button x:Name="UpdateButton" Visibility="Collapsed" Padding="8,0" Margin="0,0,12,0" Click="OnApplyUpdate" />
                    <Button x:Name="StatsButton" Background="Transparent" BorderThickness="0" Padding="6,0"
                            ToolTip="Recuento de palabras" Click="OnStatsClick">
                        <TextBlock x:Name="StatsText" Foreground="{DynamicResource ChromeForegroundBrush}" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:Sidebar x:Name="SidebarPanel" Grid.Column="0" />
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource SidebarBorderBrush}" ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSidebarResized" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:FindBar x:Name="FindBarPanel" Grid.Row="0" Visibility="Collapsed" />

                <wv2:WebView2 x:Name="EditorView" Grid.Row="1" DefaultBackgroundColor="Transparent" />
                <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Cargando editor…" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
