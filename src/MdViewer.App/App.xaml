<Application x:Class="MdViewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Valores iniciales del tema azul; ThemeManager los sustituye al cambiar de tema -->
        <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#006EE8" />
        <SolidColorBrush x:Key="ChromeForegroundBrush" Color="White" />
        <SolidColorBrush x:Key="DocumentBackgroundBrush" Color="White" />
    </Application.Resources>
</Application>
