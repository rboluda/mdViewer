<UserControl x:Class="MdViewer.App.Controls.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}">
    <Border BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,8,0" Width="70" Foreground="{DynamicResource SidebarForegroundBrush}" />
            <TextBox x:Name="FindBox" Grid.Column="1" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <ToggleButton x:Name="CaseToggle" Content="Aa" ToolTip="Distinguir mayúsculas" Padding="6,1" Margin="0,0,3,0" Click="OnOptionChanged" />
                <ToggleButton x:Name="WordToggle" Content="ab|" ToolTip="Solo palabras completas" Padding="6,1" Margin="0,0,3,0" Click="OnOptionChanged" />
                <ToggleButton x:Name="RegexToggle" Content=".*" ToolTip="Expresión regular" Padding="6,1" Margin="0,0,8,0" Click="OnOptionChanged" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" MinWidth="80" Foreground="{DynamicResource SidebarForegroundBrush}" />
                <Button Content="↑" ToolTip="Anterior (Mayús+F3)" Padding="8,1" Margin="4,0,2,0" Click="OnPreviousClick" />
                <Button Content="↓" ToolTip="Siguiente (F3)" Padding="8,1" Margin="0,0,6,0" Click="OnNextClick" />
                <Button x:Name="ReplaceToggleButton" Content="Reemplazar…" Padding="8,1" Margin="0,0,6,0" Click="OnReplaceToggleClick" />
                <Button Content="✕" ToolTip="Cerrar (Esc)" Padding="8,1" Click="OnCloseClick" />
            </StackPanel>

            <TextBlock x:Name="ReplaceLabel" Grid.Row="1" Text="Reemplazar" VerticalAlignment="Center" Margin="0,6,8,0" Foreground="{DynamicResource SidebarForegroundBrush}" />
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" PreviewKeyDown="OnReplaceKeyDown" />
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="6,6,0,0">
                <Button Content="Reemplazar" Padding="10,1" Margin="0,0,4,0" Click="OnReplaceClick" />
                <Button Content="Reemplazar todo" Padding="10,1" Click="OnReplaceAllClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
