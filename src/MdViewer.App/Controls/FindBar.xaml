<UserControl x:Class="MdViewer.App.Controls.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SidebarBackgroundBrush}" FontSize="12">
    <UserControl.Resources>
        <!-- Los controles clásicos no siguen el tema: se les dan los colores de la barra lateral -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DocumentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource SidebarForegroundBrush}" />
            <Setter Property="Padding" Value="2,1" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,6,0" Width="64" Foreground="{DynamicResource SidebarForegroundBrush}" />
            <TextBox x:Name="FindBox" Grid.Column="1" TextChanged="OnFindTextChanged" PreviewKeyDown="OnFindKeyDown" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <ToggleButton x:Name="CaseToggle" Content="Aa" ToolTip="Distinguir mayúsculas" Padding="4,0" Margin="0,0,3,0" Click="OnOptionChanged" />
                <ToggleButton x:Name="WordToggle" Content="ab|" ToolTip="Solo palabras completas" Padding="4,0" Margin="0,0,3,0" Click="OnOptionChanged" />
                <ToggleButton x:Name="RegexToggle" Content=".*" ToolTip="Expresión regular" Padding="4,0" Margin="0,0,8,0" Click="OnOptionChanged" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" MinWidth="80" Foreground="{DynamicResource SidebarForegroundBrush}" />
                <Button Content="↑" ToolTip="Anterior (Mayús+F3)" Padding="6,0" Margin="4,0,2,0" Click="OnPreviousClick" />
                <Button Content="↓" ToolTip="Siguiente (F3)" Padding="6,0" Margin="0,0,6,0" Click="OnNextClick" />
                <Button x:Name="ReplaceToggleButton" Content="Reemplazar…" Padding="6,0" Margin="0,0,6,0" Click="OnReplaceToggleClick" />
                <Button Content="✕" ToolTip="Cerrar (Esc)" Padding="6,0" Click="OnCloseClick" />
            </StackPanel>

            <TextBlock x:Name="ReplaceLabel" Grid.Row="1" Text="Reemplazar" VerticalAlignment="Center" Margin="0,3,6,0" Foreground="{DynamicResource SidebarForegroundBrush}" />
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" PreviewKeyDown="OnReplaceKeyDown" />
            <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="6,3,0,0">
                <Button Content="Reemplazar" Padding="8,0" Margin="0,0,4,0" Click="OnReplaceClick" />
                <Button Content="Reemplazar todo" Padding="8,0" Click="OnReplaceAllClick" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
